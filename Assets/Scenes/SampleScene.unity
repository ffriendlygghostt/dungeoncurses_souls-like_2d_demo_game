--- !u!114 &529621495
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 529621493}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da355640a55138646ae5b5e069d2dfe1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panel: {fileID: 529621493}
  phraseText: {fileID: 2114308609}
  phrases:
  - "\u0422\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0448\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u043C
    \u043F\u043E \u043A\u043E\u0440\u0435\u0448\u043A\u0430\u043C \u0441\u0442\u0430\u0440\u044B\u0445
    \u043A\u043D\u0438\u0433. \u0428\u0451\u043F\u043E\u0442 \u0437\u0430\u0431\u044B\u0442\u044B\u0445
    \u0438\u0441\u0442\u043E\u0440\u0438\u0439 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
    \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
    \u043C\u0430\u043D\u044F\u0442 \u0443\u0439\u0442\u0438 \u043E\u0442 \u0442\u0440\u0435\u0432\u043E\u0433.
    \u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0441\u0435\u0431\u0435
    \u043E\u0442\u0434\u044B\u0445 \u0441\u0440\u0435\u0434\u0438 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
    \u0432\u0435\u043A\u043E\u0432?"
  - "\u0422\u0443\u0441\u043A\u043B\u044B\u0439 \u0441\u0432\u0435\u0442 \u043B\u044C\u0451\u0442\u0441\u044F
    \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443.
    \u0417\u0434\u0435\u0441\u044C \u0446\u0430\u0440\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435,
    \u0438 \u0448\u0435\u043B\u0435\u0441\u0442 \u0441\u0442\u0440\u0430\u043D\u0438\u0446
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043E\u0439. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C\u0441\u044F \u0432
    \u044D\u0442\u043E\u0442 \u043C\u0438\u0440 \u2014 \u043C\u0443\u0434\u0440\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
  - "\u0412\u043E\u043A\u0440\u0443\u0433 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u043C\u0438
    \u0442\u043E\u043C\u0430\u043C\u0438 \u0438 \u0442\u0430\u0439\u043D\u0430\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D\u0438 \u0445\u0440\u0430\u043D\u044F\u0442.
    \u0421\u0435\u0440\u0434\u0446\u0435 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
    \u0431\u0435\u0433, \u0430 \u043C\u044B\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u044F\u0441\u043D\u0435\u0435. \u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u043E\u0438\u0442
    \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E \u0437\u0430\u0431\u044B\u0442\u044C
    \u043E \u0442\u0440\u0435\u0432\u043E\u0433\u0430\u0445 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C
    \u0441\u0435\u0431\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043A\u043E\u044F?"
  - "\u041F\u043E\u043A\u0430 \u0437\u0430 \u0434\u0432\u0435\u0440\u044F\u043C\u0438
    \u0448\u0443\u043C\u0438\u0442 \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043C\u0438\u0440,
    \u0437\u0434\u0435\u0441\u044C, \u0443 \u043A\u043D\u0438\u0436\u043D\u043E\u0439
    \u043F\u043E\u043B\u043A\u0438, \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u0435\u0439\u0447\u0430\u0441
    \u2014 \u043B\u0443\u0447\u0448\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438
    \u0434\u0443\u0445 \u0438 \u043E\u0431\u0440\u0435\u0441\u0442\u0438 \u0441\u0438\u043B\u044B
    \u0434\u043B\u044F \u043D\u043E\u0432\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
  - "\u0422\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0448\u044C \u043A \u043F\u043E\u043B\u043A\u0435,
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F \u043B\u0451\u0433\u043A\u0438\u0439
    \u0445\u043E\u043B\u043E\u0434\u043E\u043A \u0434\u0440\u0435\u0432\u043D\u0435\u0439
    \u043C\u0430\u0433\u0438\u0438. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043D\u0438\u0433\u0438
    \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u0442\u0432\u043E\u0439 \u043F\u043E\u043A\u043E\u0439.
    \u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0443
    \u0432 \u044D\u0442\u043E\u043C \u0443\u043A\u0440\u043E\u043C\u043D\u043E\u043C
    \u0443\u0433\u043E\u043B\u043A\u0435?"
