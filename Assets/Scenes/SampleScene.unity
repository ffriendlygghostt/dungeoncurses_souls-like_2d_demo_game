  m_text: "\u0412\u043E\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u0435\u0437
    \u041C\u0430\u043B\u0435\u043D\u0438\u0438 \u2014 \u0441\u0438\u043C\u0432\u043E\u043B
    \u0435\u0451 \u0441\u043B\u0430\u0432\u043D\u044B\u0445 \u043F\u043E\u0431\u0435\u0434.
    \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043A\u043B\u044F\u043D\u0443\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
    \u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u0430\u043A \u0438\u0437 \u043A\u043B\u0438\u043D\u043A\u0430
    \u0432\u044B\u0440\u0430\u0441\u0442\u0430\u044E\u0442 \u043A\u0440\u044B\u043B\u044C\u044F
    \u2014 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435 \u043D\u0435\u0441\u0433\u0438\u0431\u0430\u0435\u043C\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430 \u0430\u043B\u043E\u0439 \u0432\u0430\u043B\u044C\u043A\u0438\u0440\u0438\u0438,
    \u043D\u0435 \u0437\u043D\u0430\u0432\u0448\u0435\u0439 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0439."
