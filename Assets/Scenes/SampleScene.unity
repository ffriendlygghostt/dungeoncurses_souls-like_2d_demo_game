    - target: {fileID: 6136463933283882604, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_Name
      value: StoryNote (1)
      objectReference: {fileID: 0}
    - target: {fileID: 8126256613159793627, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_text
      value: "\u042F \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u0441\u0443\u043D\u0434\u0443\u043A\u2026
        \u0438 \u0440\u0435\u0448\u0438\u043B\u0430, \u0447\u0442\u043E \u043E\u043D
        \u043C\u043E\u0439.\n\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435\u0442?
        \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0440\u0430\u043B\u0430
        \u0442\u043E, \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B\u0430.\n\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
        \u2014 \u043C\u043E\u0451 \u043E\u0440\u0443\u0436\u0438\u0435, \u0432\u0442\u043E\u0440\u0430\u044F
        \u2014 \u043C\u043E\u0439 \u0442\u0438\u0442\u0443\u043B. \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430.
        \u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0430. \u0421\u043E\u0431\u043B\u0430\u0437\u043D
        \u0438 \u0432\u043B\u0430\u0441\u0442\u044C.\n\u042F \u0447\u0442\u043E,
        \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0441\u0443\u043D\u0434\u0443\u043A \u0432 \u044D\u0442\u043E\u043C \u043F\u044B\u043B\u044C\u043D\u043E\u043C,
        \u0437\u0430\u0442\u0445\u043B\u043E\u043C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435?..\n\n\u041A\u0430\u043A
        \u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u0441\u044E\u0434\u0430 \u043F\u043E\u043F\u0430\u043B\u0430?\n\n\u042F
        \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u0413\u0435\u043D\u0440\u0438.\n\u041C\u043E\u0439
        \u0440\u044B\u0446\u0430\u0440\u044C\u2026 \u043C\u043E\u0439 \u043D\u0430\u0438\u0432\u043D\u044B\u0439
        \u0433\u043B\u0443\u043F\u0435\u0446. \u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451
        \u0432\u0435\u0440\u0438\u0442, \u0447\u0442\u043E \u044F \u2014 \u0441\u0432\u0435\u0442.\n\u041D\u043E
        \u043E\u043D \u043F\u0440\u0438\u0434\u0451\u0442. \u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430
        \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442. \u041E\u043D\u2026 \u0434\u043E\u043B\u0436\u0435\u043D.\n\n\u041A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0442\u0438\u043F \u0437\u0430\u043F\u0435\u0440 \u043C\u0435\u043D\u044F.
        \u0411\u0440\u043E\u043D\u044F, \u043A\u0430\u043A \u0438\u0437 \u0443\u0433\u043B\u044F
        \u0438 \u0441\u0442\u0430\u043B\u0438.\n\u0421\u043C\u043E\u0442\u0440\u0435\u043B,
        \u043A\u0430\u043A \u043D\u0430 \u043F\u0430\u0434\u0448\u0443\u044E. \u041E\u043D
        \u0443\u0448\u0451\u043B, \u0430 \u044F \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C.\n\u0421\u043E
        \u0441\u0432\u0435\u0447\u0430\u043C\u0438.\n\n\u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
        \u0441\u043E \u043C\u043D\u043E\u0439.\n\u0428\u0435\u043F\u0447\u0443\u0442.
        \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u2014 \u0442\u0438\u0445\u043E,
        \u0435\u0434\u0432\u0430 \u0441\u043B\u044B\u0448\u043D\u043E. \u041F\u043E\u0442\u043E\u043C
        \u0433\u0440\u043E\u043C\u0447\u0435.\n\u041E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442
        \u0432\u0441\u0451.\n\n\u042F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
        \u0438\u0445 \u043F\u043E\u0442\u0443\u0448\u0438\u0442\u044C.\n\u041D\u043E
        \u043E\u043D\u0438 \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u043B\u0438
        \u0441\u043D\u043E\u0432\u0430.\n\u0428\u0435\u043F\u0442\u0430\u043B\u0438
        \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u043B\u044E\u0434\u044C\u043C\u0438. \u041E \u0442\u043E\u043C, \u0447\u0442\u043E
        \u044F \u0431\u0440\u0430\u043B\u0430 \u2014 \u043D\u0435 \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E,
        \u0430 \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u043D\u043E\u0435.\n\u042F
        \u0442\u0443\u0448\u0438\u043B\u0430 \u0438 \u0442\u0443\u0448\u0438\u043B\u0430...
        \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u043D\u044F\u043B\u0430,
        \u0447\u0442\u043E \u0433\u043E\u0440\u044E \u044F.\n\n\u041C\u043E\u0451
        \u0442\u0435\u043B\u043E\u2026 \u043A\u043E\u0436\u0430, \u043A\u0430\u043A
        \u0432\u043E\u0441\u043A.\n\n\u0418 \u043A\u043E\u0433\u0434\u0430 \u044F
        \u0440\u0443\u0445\u043D\u0443\u043B\u0430 \u2014 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u0430\u044F,
        \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u2014 \u043E\u043D\u0438
        \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435:\n\n\xAB\u0422\u044B
        \u043D\u0435 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u0430 \u041F\u043B\u0430\u043C\u0435\u043D\u0438
        \u0418\u0441\u043A\u0443\u043F\u043B\u0435\u043D\u0438\u044F\u2026\xBB\n\n\u0422\u0435\u043F\u0435\u0440\u044C
        \u0441\u0432\u0435\u0442 \u0433\u0430\u0441\u043D\u0435\u0442.\n\u042F \u0431\u043E\u044E\u0441\u044C.\n\n\u0413\u0435\u043D\u0440\u0438\u2026\n\u041C\u0430\u043C\u0430\u2026\n\u041F\u0430\u043F\u0430\u2026\n\n\u042F
        \u0445\u043E\u0447\u0443 \u0434\u043E\u043C\u043E\u0439."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
