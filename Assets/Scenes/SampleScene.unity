    - target: {fileID: 5767470680901615006, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6136463933283882604, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_Name
      value: StoryNote
      objectReference: {fileID: 0}
    - target: {fileID: 8126256613159793627, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_text
      value: "\u041C\u044B \u0448\u043B\u0438 \u0441\u044E\u0434\u0430 \u0441 \u043D\u0430\u0434\u0435\u0436\u0434\u043E\u0439.
        \u042F \u0441\u043E\u0431\u0440\u0430\u043B \u043E\u0442\u0440\u044F\u0434
        \u2014 \u0431\u044B\u0432\u0430\u043B\u044B\u0435 \u0432\u043E\u0438\u043D\u044B,
        \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0438, \u0443\u0431\u0438\u0439\u0446\u044B
        \u0447\u0443\u0434\u0438\u0449. \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437
        \u043D\u0430\u0441 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435
        \u0431\u043E\u043B\u044C, \u043D\u043E \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
        \u0432\u0435\u0440\u0438\u043B \u0432 \u0441\u0438\u043B\u0443 \u0441\u0442\u0430\u043B\u0438
        \u0438 \u0443\u0434\u0430\u0447\u0443.\n\n\u041C\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C
        \u0432 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445
        \u0437\u0430\u043B\u0430\u0445 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F.
        \u0421\u0443\u0434\u044C\u0431\u0430 \u0441\u0432\u0435\u043B\u0430 \u043D\u0430\u0441
        \u0443 \u044D\u0442\u0438\u0445 \u0432\u0440\u0430\u0442. \u041C\u044B \u0434\u043E\u043B\u0433\u043E
        \u0441\u0442\u043E\u044F\u043B\u0438 \u0432 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438:
        \u043E\u0442\u0442\u0443\u0434\u0430 \u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430
        \u0433\u043D\u0438\u044E\u0449\u0430\u044F \u0430\u0443\u0440\u0430 \u0442\u044C\u043C\u044B.
        \u041D\u0435\u0447\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u0435\u0435
        \u0434\u044B\u0448\u0430\u043B\u043E \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
        \u0438 \u044D\u0442\u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u0436\u0433\u043B\u043E
        \u0434\u0430\u0436\u0435 \u0434\u0443\u0448\u0443.\n\n\u041D\u043E \u0441\u0442\u0440\u0430\u0445
        \u0431\u044B\u043B \u043D\u0435\u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u043C
        \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C. \u041C\u044B \u0448\u0430\u0433\u043D\u0443\u043B\u0438
        \u0432\u043D\u0443\u0442\u0440\u044C \u2014 \u0432\u0441\u0435 \u0440\u0430\u0437\u043E\u043C.\n\n\u0422\u0432\u0430\u0440\u044C
        \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430 \u043D\u0430\u0441.
        \u0421\u0430\u043C\u0430 \u0441\u043C\u0435\u0440\u0442\u044C, \u043F\u0440\u0438\u043D\u044F\u0432\u0448\u0430\u044F
        \u043E\u0431\u043B\u0438\u043A: \u043E\u043A\u0443\u0442\u0430\u043D\u043D\u0430\u044F
        \u0442\u044C\u043C\u043E\u0439, \u0441 \u043A\u043E\u0441\u043E\u0439 \u0432
        \u0440\u0443\u043A\u0430\u0445.\n\u041C\u044B \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0438
        \u0438 \u043C\u0438\u043D\u0443\u0442\u044B.\n\n\u042F \u0432\u0438\u0434\u0435\u043B,
        \u043A\u0430\u043A \u0433\u043E\u0440\u0435\u043B\u0438 \u0442\u0435\u043B\u0430,\n\u043A\u0430\u043A
        \u0434\u0443\u0448\u0438 \u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
        \u0432 \u043F\u0435\u043F\u0435\u043B,\n\u043A\u0430\u043A \u0434\u0440\u0443\u0437\u044C\u044F
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u0441\u043A\u0435\u043B\u0435\u0442\u0430\u043C\u0438
        \u043F\u043E\u0434 \u0435\u0451 \u0432\u043E\u043B\u0435\u0439.\n\n\u042F
        \u0431\u0435\u0436\u0430\u043B, \u0440\u0430\u043D\u0435\u043D\u044B\u0439
        \u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439. \u0413\u043D\u0438\u043B\u044C
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0441\u044A\u0435\u0434\u0430\u0435\u0442
        \u043C\u0435\u043D\u044F. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
        \u044D\u0442\u043E \u043C\u043E\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0441\u043B\u043E\u0432\u0430.\n\n\u041A\u043E\u0433\u0434\u0430-\u0442\u043E
        \u044F \u0431\u044B\u043B \u0442\u043E\u0440\u0433\u0430\u0448\u043E\u043C.
        \u0416\u0430\u0434\u043D\u044B\u043C. \u041F\u043E\u0434\u043B\u044B\u043C.
        \u042F \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u043B \u043E\u0442\u0440\u0430\u0432\u0443
        \u043A\u0430\u043A \u0437\u0435\u043B\u044C\u044F, \u043F\u0440\u0435\u0434\u0430\u0432\u0430\u043B
        \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B. \u0425\u043E\u0442\u0435\u043B
        \u043B\u0438\u0448\u044C \u0437\u043E\u043B\u043E\u0442\u0430.\n\u0418 \u0432\u043E\u0442
        \u044F \u0437\u0434\u0435\u0441\u044C. \u041C\u043E\u044F \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u044C
        \u0441\u0442\u0430\u043B\u0430 \u043C\u043E\u0438\u043C \u0433\u0440\u0435\u0445\u043E\u043C.
        \u0418 \u044F \u0440\u0430\u0441\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C.\n\n\u041D\u043E
        \u0435\u0441\u043B\u0438 \u0442\u044B \u0432\u0441\u0451 \u0436\u0435 \u043F\u043E\u0439\u0434\u0451\u0448\u044C
        \u0432\u043D\u0443\u0442\u0440\u044C\u2026 \u0437\u0430\u043F\u043E\u043C\u043D\u0438:\n\n\u0410\u043D\u0433\u0435\u043B
        \u0421\u043C\u0435\u0440\u0442\u0438 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
        \u0432 \u0443\u043F\u043E\u0440 \u2014 \u0431\u044B\u0441\u0442\u0440\u043E
        \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437
        \u043F\u043E\u0434\u0440\u044F\u0434.\n\u0415\u0451 \u0430\u0442\u0430\u043A\u0438
        \u043C\u043E\u0436\u043D\u043E \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u2026
        \u0435\u0441\u043B\u0438 \u0445\u0432\u0430\u0442\u0438\u0442 \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u0438.\n\u041D\u043E
        \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0434\u043E\u043B\u0433\u043E \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
        \u0443\u0434\u0430\u0440 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u0435\u043D.
        \u0422\u0430\u043A\u043E\u0435 \u043D\u0435 \u043F\u0430\u0440\u0438\u0440\u0443\u044E\u0442.
        \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0433\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 8126256613159793627, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
