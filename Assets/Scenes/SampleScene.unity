    - target: {fileID: 5767470680901615006, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6136463933283882604, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_Name
      value: StoryNote (2)
      objectReference: {fileID: 0}
    - target: {fileID: 8126256613159793627, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_text
      value: "\u041A\u0442\u043E \u0432 \u043F\u043B\u0430\u043C\u044F \u0441\u0442\u0443\u043F\u0438\u0442
        \u2014 \u043D\u0435 \u043A \u0441\u043F\u0430\u0441\u0435\u043D\u044C\u044E
        \u0441\u043F\u0435\u0448\u0438\u0442,\n\u0410 \u043A \u043F\u0440\u0430\u0432\u0434\u0435,
        \u0447\u0442\u043E \u0441 \u043A\u043E\u0436\u0435\u0439 \u0441\u0433\u043E\u0440\u0430\u0435\u0442,
        \u043A\u0430\u043A \u043D\u0438\u0442\u044C.\n\u0410\u043B\u044B\u0439 \u043E\u0433\u043E\u043D\u044C
        \u043D\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442 \u043D\u0430
        \"\u0437\u043B\u043E\" \u0438 \"\u0441\u0432\u044F\u0442\u043E\u0439\" \u2014\n\u041E\u043D
        \u0441\u0443\u0434\u0438\u0442 \u043B\u0438\u0448\u044C \u0442\u0435\u0445,
        \u043A\u0442\u043E \u0433\u043E\u0442\u043E\u0432 \u0431\u044B\u0442\u044C
        \u0441\u043E\u0431\u043E\u0439.\n\n\u0413\u0440\u0435\u0445\u043E\u0432 \u043D\u0435
        \u0431\u043E\u0438\u0442\u0441\u044F \u043E\u043D \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
        \u043E\u0431\u043C\u0430\u043D\u0430.\n\u041B\u043E\u0436\u044C \u0432 \u043D\u0451\u043C
        \u0442\u0440\u0435\u0441\u043A\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u043A
        \u0441\u0442\u0430\u0440\u0430\u044F \u0442\u043A\u0430\u043D\u044C.\n\u041D\u043E
        \u043A\u0442\u043E \u043D\u0430\u0437\u043E\u0432\u0451\u0442 \u0441\u0432\u043E\u044E
        \u0432\u0438\u043D\u0443 \u0431\u0435\u0437 \u043E\u0433\u043B\u044F\u0434\u043A\u0438
        \u2014\n\u0422\u043E\u043C\u0443 \u043E\u0431\u0440\u0430\u0442\u0438\u0442
        \u043E\u043D \u0432 \u043F\u0435\u043F\u0435\u043B \u0432\u0441\u0435 \u043F\u044F\u0442\u043D\u0430.\n\n\u0413\u043E\u0432\u043E\u0440\u044F\u0442,
        \u043F\u043B\u0430\u043C\u044F \u044D\u0442\u043E \u0431\u044B\u043B\u043E
        \u043F\u0440\u0435\u0436\u0434\u0435 \u0445\u0440\u0430\u043C\u043E\u0432.\n\u041F\u0440\u0435\u0436\u0434\u0435
        \u0441\u043B\u043E\u0432.\n\u041E\u043D\u043E \u043D\u0435 \u0431\u044B\u043B\u043E
        \u043E\u0433\u043D\u0451\u043C \u2014 \u043E\u043D\u043E \u0431\u044B\u043B\u043E
        \u0432\u043E\u043B\u0435\u0439.\n\u041D\u0435 \u0441\u0443\u0434\u043E\u043C,
        \u043D\u0435 \u043C\u0438\u043B\u043E\u0441\u0442\u044C\u044E, \u043D\u043E
        \u0437\u0435\u0440\u043A\u0430\u043B\u043E\u043C.\n\u0418 \u0432\u0441\u044F\u043A\u0438\u0439,
        \u043A\u0442\u043E \u0432\u0441\u0442\u0443\u043F\u0430\u043B \u0432 \u043D\u0435\u0433\u043E,\n\u0432\u0438\u0434\u0435\u043B
        \u043D\u0435 \u043A\u0430\u0440\u0443 \u2014\n\u043D\u043E \u0442\u043E,
        \u0447\u0442\u043E \u0441\u0430\u043C \u0443\u0442\u0430\u0438\u043B \u043E\u0442
        \u0441\u0435\u0431\u044F.\n\n\u041F\u043B\u0430\u043C\u044F \u043D\u0435
        \u0449\u0430\u0434\u0438\u0442 \u0442\u0435\u043B\u0430. \u041E\u043D\u043E
        \u0449\u0430\u0434\u0438\u0442 \u043F\u0440\u0430\u0432\u0434\u0443.\n\u041E\u043D\u043E
        \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043A\u0440\u0438\u043A\u0430
        \u2014\n\u043D\u043E \u0441\u043B\u044B\u0448\u0438\u0442 \u043A\u0430\u0436\u0434\u0443\u044E
        \u043D\u0435\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E \u0432\u0438\u043D\u0443.\n\n\u041A\u0442\u043E
        \u0432\u0441\u0442\u0430\u043B \u0432 \u043D\u0451\u043C \u0438 \u0441\u043E\u043B\u0433\u0430\u043B
        \u2014\n\u0431\u044B\u043B \u0438\u0441\u043F\u0435\u043F\u0435\u043B\u0451\u043D.\n\u041A\u0442\u043E
        \u0432\u0441\u0442\u0430\u043B \u0432 \u043D\u0451\u043C \u0438 \u043C\u043E\u043B\u0447\u0430\u043B
        \u2014 \u0438\u0441\u0447\u0435\u0437 \u0431\u0435\u0437 \u0441\u043B\u0435\u0434\u0430.\n\u041D\u043E
        \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043B
        \u0441\u0432\u043E\u0439 \u0433\u0440\u0435\u0445, \u043D\u0435 \u043F\u0440\u044F\u0447\u0430
        \u0432\u0437\u0433\u043B\u044F\u0434\u0430,\n\u0441\u0433\u043E\u0440\u0430\u043B
        \u2014\n\u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F.\n\n\u041E\u0442
        \u043D\u0435\u0433\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
        \u043D\u0438 \u043A\u043E\u0436\u0438, \u043D\u0438 \u0440\u0430\u043D.\n\u041B\u0438\u0448\u044C
        \u043F\u0435\u043F\u0435\u043B \u0438 \u0438\u043C\u044F, \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u043E\u0435
        \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043C.\n\u041D\u0435 \u0434\u043B\u044F
        \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F.\n\u0414\u043B\u044F \u043F\u0430\u043C\u044F\u0442\u0438."
