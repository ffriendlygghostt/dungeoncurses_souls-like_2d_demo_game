  m_text: "\u0422\u0443\u0441\u043A\u043B\u044B\u0439 \u0441\u0432\u0435\u0442 \u043B\u044C\u0451\u0442\u0441\u044F
    \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443.
    \u0417\u0434\u0435\u0441\u044C \u0446\u0430\u0440\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435,
    \u0438 \u0448\u0435\u043B\u0435\u0441\u0442 \u0441\u0442\u0440\u0430\u043D\u0438\u0446
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043E\u0439. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C\u0441\u044F \u0432
    \u044D\u0442\u043E\u0442 \u043C\u0438\u0440 \u2014 \u043C\u0443\u0434\u0440\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
