    - target: {fileID: 5767470680901615006, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6136463933283882604, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_Name
      value: StoryNote
      objectReference: {fileID: 0}
    - target: {fileID: 6136463933283882604, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8126256613159793627, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
      propertyPath: m_text
      value: "\u041E\u043D\u0430\u2026 \u043E\u043D\u0430 \u0431\u044B\u043B\u0430
        \u0441\u043E \u043C\u043D\u043E\u0439. \u041C\u043E\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0430\u044F,
        \u0441\u0432\u0435\u0442\u043B\u0430\u044F. \u041C\u044B \u043B\u0438\u0448\u044C
        \u043D\u0430 \u043C\u0438\u0433 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C.
        \u041D\u0430 \u043C\u0438\u0433!\n\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
        \u2014 \u0438 \u0434\u0432\u0435\u0440\u044C \u0431\u044B\u043B\u0430 \u0437\u0430\u043F\u0435\u0440\u0442\u0430.
        \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0430\u044F, \u043E\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F,
        \u0436\u0438\u0432\u0430\u044F.\n\n\u041A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u0443\u0431\u043B\u044E\u0434\u043E\u043A \u0432 \u0442\u044F\u0436\u0451\u043B\u043E\u0439
        \u0431\u0440\u043E\u043D\u0435\u2026 \u043E\u043D \u0437\u0430\u043A\u0440\u044B\u043B
        \u0435\u0451. \u042F \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u043E\u043D
        \u0443\u0445\u043E\u0434\u0438\u043B, \u0431\u0443\u0434\u0442\u043E \u043D\u0435
        \u043D\u0435\u0441\u044F \u0432\u0438\u043D\u044B. \u041C\u0440\u0430\u0437\u044C.
        \u042F \u0440\u0430\u0437\u0440\u0443\u0431\u043B\u044E \u0435\u0433\u043E,
        \u0435\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0443.\n\n\u041F\u043E\u043A\u0430
        \u044F \u0441\u0442\u043E\u044F\u043B \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438,
        \u0440\u044F\u0434\u043E\u043C \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
        \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439\u2026 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446?
        \u041F\u0440\u0438\u0437\u0440\u0430\u043A. \u0411\u043B\u0435\u0434\u043D\u044B\u0439,
        \u043A\u0430\u043A \u0441\u043C\u0435\u0440\u0442\u044C, \u0441 \u0433\u043E\u043B\u043E\u0441\u043E\u043C
        \u0431\u0443\u0434\u0442\u043E \u0438\u0437 \u043F\u0435\u043F\u043B\u0430.\n\u041E\u043D
        \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043C\u043E\u044F
        \u0432\u043E\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u0430\u044F
        \u0431\u044B\u043B\u0430 \u043E\u0442\u0440\u0438\u043D\u0443\u0442\u0430
        \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A\u043E\u043C \u041F\u043B\u0430\u043C\u0435\u043D\u0438.
        \u0427\u0442\u043E \u0435\u0451 \"\u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435\"
        \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C. \u0427\u0442\u043E \u0435\u0451
        \u0434\u0443\u0448\u0443 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0443\u0434\u044F\u0442.\n\n\u041E\u043D
        \u0437\u043D\u0430\u043B, \u0433\u0434\u0435 \u043A\u043B\u044E\u0447. \u0413\u043E\u0432\u043E\u0440\u0438\u043B,
        \u0441 \u043D\u0430\u0441\u043C\u0435\u0448\u043A\u043E\u0439:\n\n\xAB\u0417\u0430\u043B
        \u041F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0421\u0443\u0434\u0430\u2026
        \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
        \u044D\u0442\u0430\u0436\u0430. \u041D\u0430\u0439\u0434\u0451\u0448\u044C
        \u043B\u0438 \u0442\u044B \u0435\u0433\u043E \u2014 \u0438\u043B\u0438 \u043E\u043D
        \u043D\u0430\u0439\u0434\u0451\u0442 \u0442\u0435\u0431\u044F?\xBB\n\n\u041A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u0442\u0430\u043C \u043E\u0433\u043E\u043D\u044C \u0432\u043E\u0437\u043E\u043C\u043D\u0438\u043B
        \u0441\u0435\u0431\u044F \u0441\u0443\u0434\u044C\u0451\u0439?\n\u0421\u0443\u0434\u044C\u0451\u0439
        \u043D\u0430\u0434 \u043D\u0435\u0439?\n\n\u0425\u0430.\n\u041F\u0443\u0441\u0442\u044C
        \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F
        \u0433\u043E\u0440\u0435\u0442\u044C \u0434\u0432\u0430\u0436\u0434\u044B.\n\u042F
        \u0438\u0434\u0443."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 3a3a56214a69a4c43aa2a61ab5d1bdbb, type: 3}
